# GridPulse configuration. Copy to .env in the repository root and fill in the CHANGE_ME values.
# .env is git-ignored. Never commit it.

# ---- Required -----------------------------------------------------------------------------------
# Development database. The backend refuses to start without it (PostgreSQL only).
# Pick any password for the "gridpulse" role; scripts/setup creates the role with it.
# If the password contains @ : / ? # or %, URL-encode it (e.g. @ -> %40).
GRIDPULSE_DATABASE_URL=postgresql+psycopg://gridpulse:CHANGE_ME@localhost:5432/gridpulse

# Test database, used only by pytest. The suite drops and recreates every table in it, so its name
# must end in _test and it must differ from the development database (both are enforced).
GRIDPULSE_TEST_DATABASE_URL=postgresql+psycopg://gridpulse:CHANGE_ME@localhost:5432/gridpulse_test

# Required. Random secret (>= 32 chars) used to key HMACs of client addresses for rate limiting.
# The setup scripts generate one automatically when this still says CHANGE_ME.
GRIDPULSE_SECRET_KEY=CHANGE_ME

# Operator session cookies are Secure (HTTPS-only) by default. Set to false ONLY for local http development.
GRIDPULSE_COOKIE_SECURE=false

# ---- PostgreSQL superuser (setup only; the running app never uses these) -------------------------
# Used by backend/scripts/db_setup.py to create the role and databases above, and by
# docker-compose.yml as the container's superuser password.
#   Docker:            postgres + the password you choose here
#   Windows installer: postgres + the password you chose during installation
#   Homebrew (macOS):  your macOS username, password empty
GRIDPULSE_PG_ADMIN_USER=postgres
GRIDPULSE_PG_ADMIN_PASSWORD=CHANGE_ME

# ---- Optional -----------------------------------------------------------------------------------
# LLM provider for Sentinel triage: fallback | openai_compatible | anthropic
GRIDPULSE_LLM_PROVIDER=fallback
# openai_compatible: any Chat Completions endpoint (e.g. hackathon Astra credits, if they expose one)
# anthropic: Claude via the Anthropic SDK (model defaults to claude-opus-5-5)
GRIDPULSE_LLM_BASE_URL=
GRIDPULSE_LLM_API_KEY=
GRIDPULSE_LLM_MODEL=
GRIDPULSE_LLM_TIMEOUT_S=20
# The backend refuses to start if a non-fallback provider lacks a key/model or the model is a placeholder.
GRIDPULSE_LLM_MAX_RETRIES=1

GRIDPULSE_MAX_REVISIONS=2
GRIDPULSE_EVIDENCE_FRESH_MINUTES=30
# Pause between workflow stages so the UI can show progress (0 = none)
GRIDPULSE_WORKFLOW_STEP_DELAY_MS=700
GRIDPULSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Abuse controls (defaults shown)
# GRIDPULSE_REPORT_LIMIT_PER_10MIN=5
# GRIDPULSE_REPORT_LIMIT_PER_DAY=20
# GRIDPULSE_LOGIN_FAILURES_PER_15MIN=5
